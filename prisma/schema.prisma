generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  image        String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members    Member[]
  ownedPools Pool[]     @relation("PoolHost")
  rsvps      Rsvp[]
  proposals  Proposal[]
}

model Pool {
  id                 String   @id @default(cuid())
  name               String
  description        String
  image              String?
  purpose            String   @default("")
  contributionAmount Int      @default(0)
  hostId             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  host          User           @relation("PoolHost", fields: [hostId], references: [id])
  members       Member[]
  moves         Move[]
  proposals     Proposal[]
  contributions Contribution[]
  transactions  Transaction[]
}

model Member {
  id       String   @id @default(cuid())
  userId   String
  poolId   String
  role     String   @default("member")
  status   String   @default("active")
  joinedAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool          Pool           @relation(fields: [poolId], references: [id], onDelete: Cascade)
  votes         Vote[]
  contributions Contribution[]

  @@unique([userId, poolId])
}

model Move {
  id          String    @id @default(cuid())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime?
  location    String
  cost        Int       @default(0)
  status      String    @default("upcoming")
  poolId      String
  proposalId  String?
  createdAt   DateTime  @default(now())

  pool         Pool          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  proposal     Proposal?     @relation(fields: [proposalId], references: [id])
  rsvps        Rsvp[]
  transactions Transaction[]
}

model Rsvp {
  id        String   @id @default(cuid())
  userId    String
  moveId    String
  status    String   @default("in")
  optedInAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  move Move @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@unique([userId, moveId])
}

model Proposal {
  id            String   @id @default(cuid())
  poolId        String
  authorId      String
  title         String
  description   String
  estimatedCost Int      @default(0)
  status        String   @default("submitted")
  voteCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pool   Pool   @relation(fields: [poolId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  Vote[]
  moves  Move[]
}

model Vote {
  id         String   @id @default(cuid())
  proposalId String
  memberId   String
  value      Int      @default(1)
  createdAt  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([proposalId, memberId])
}

model Contribution {
  id       String   @id @default(cuid())
  memberId String
  poolId   String
  amount   Int
  date     DateTime @default(now())
  status   String   @default("completed")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pool   Pool   @relation(fields: [poolId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  poolId      String
  type        String
  amount      Int
  description String
  moveId      String?
  createdAt   DateTime @default(now())

  pool Pool  @relation(fields: [poolId], references: [id], onDelete: Cascade)
  move Move? @relation(fields: [moveId], references: [id], onDelete: Cascade)
}
